          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name, CASE s.category WHEN 'romanian_news' THEN 'Romanian News' WHEN 'tech' THEN 'Tech' ELSE initcap(replace(s.category, '_', ' ')) END AS category, count(i.id) AS items, max(i.first_seen_at) AS latest_item FROM sources s LEFT JOIN items i ON i.source_id = s.id WHERE s.enabled AND s.source_type = 'rss' AND s.category IN ('romanian_news', 'tech') GROUP BY s.id, s.name, category ORDER BY items DESC, s.name;",
