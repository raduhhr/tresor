# Managed by Ansible: nginx-music role / {{ nginx_updates_config_name }} (TLS production)

server {
  listen 80;
  listen [::]:80;
  server_name {{ nginx_updates_domain }};

  location /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name {{ nginx_updates_domain }};

  ssl_certificate     /etc/letsencrypt/live/{{ nginx_updates_domain }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ nginx_updates_domain }}/privkey.pem;
  include             /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

{% if nginx_updates_hsts %}
  add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;

  access_log {{ nginx_updates_access_log }};
  error_log  {{ nginx_updates_error_log }} warn;

  root {{ nginx_updates_root }};
  autoindex off;

  location = / {
    return 404;
  }

  location = /{{ nginx_updates_path }}/update.json {
    default_type application/json;
    try_files $uri =404;
{% if nginx_updates_hsts %}
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
  }

  location = /{{ nginx_updates_path }}/BatchYTDownloaderSetup.exe {
    default_type application/octet-stream;
    try_files $uri =404;
{% if nginx_updates_hsts %}
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "public, max-age=3600" always;
    add_header Content-Disposition "attachment; filename=\"BatchYTDownloaderSetup.exe\"" always;
  }

  location /{{ nginx_updates_path }}/ {
    try_files $uri =404;
{% if nginx_updates_hsts %}
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "public, max-age=300" always;
  }

  location ~ /\. {
    deny all;
  }
}
