satelite_watcher_root: {{ satelite_watcher_root }}
python_bin: {{ satelite_watcher_python_bin }}
satdump_bin: {{ satelite_watcher_satdump_bin }}
timezone: {{ satelite_watcher_timezone }}

paths:
  output_base_dir: {{ satelite_watcher_recordings_dir }}
  recordings_dir: {{ satelite_watcher_recordings_dir }}
  logs_dir: {{ satelite_watcher_logs_dir }}
  state_dir: {{ satelite_watcher_state_dir }}
  pass_metadata_dir: {{ satelite_watcher_pass_metadata_dir }}
  tle_cache_file: {{ satelite_watcher_tle_cache_file }}
  passes_file: {{ satelite_watcher_passes_file }}
  scheduled_file: {{ satelite_watcher_scheduled_file }}
  notifications_file: {{ satelite_watcher_notifications_file }}
  iss_sstv_events_file: {{ satelite_watcher_iss_sstv_events_file }}

sdr:
  source: {{ satelite_watcher_sdr_source }}
  device_id: "{{ satelite_watcher_sdr_device_id }}"
  gain: {{ satelite_watcher_sdr_gain }}
  samplerate: {{ satelite_watcher_sdr_samplerate }}
  baseband_format: {{ satelite_watcher_sdr_baseband_format }}
  record_frequency_offset_hz: {{ satelite_watcher_record_frequency_offset_hz }}

decode:
  satelite_watcher_after_record:
    enabled: {{ 'true' if satelite_watcher_decode_after_record_enabled | bool else 'false' }}
    pipeline: {{ satelite_watcher_decode_pipeline }}
    source_mode: {{ satelite_watcher_decode_source_mode }}
    freq_shift_hz: {{ satelite_watcher_decode_freq_shift_hz }}
    dc_block: {{ 'true' if satelite_watcher_decode_dc_block | bool else 'false' }}
    iq_swap: {{ 'true' if satelite_watcher_decode_iq_swap | bool else 'false' }}
    output_dir_name: {{ satelite_watcher_decode_output_dir_name }}
    target_satellites:
{% for satellite_name in satelite_watcher_decode_target_satellites %}
      - {{ satellite_name }}
{% else %}
      []
{% endfor %}
  noaa_apt:
    enabled: {{ 'true' if satelite_watcher_decode_noaa_apt_enabled | bool else 'false' }}
    pipeline: {{ satelite_watcher_decode_noaa_apt_pipeline }}
    source_mode: {{ satelite_watcher_decode_noaa_apt_source_mode }}
    freq_shift_hz: {{ satelite_watcher_decode_noaa_apt_freq_shift_hz }}
    dc_block: {{ 'true' if satelite_watcher_decode_noaa_apt_dc_block | bool else 'false' }}
    iq_swap: {{ 'true' if satelite_watcher_decode_noaa_apt_iq_swap | bool else 'false' }}
    output_dir_name: {{ satelite_watcher_decode_noaa_apt_output_dir_name }}
    target_satellites:
{% for satellite_name in satelite_watcher_decode_noaa_apt_target_satellites %}
      - {{ satellite_name }}
{% else %}
      []
{% endfor %}
  image_after_decode:
    enabled: {{ 'true' if satelite_watcher_generate_image_after_decode_enabled | bool else 'false' }}
    output_dir_name: {{ satelite_watcher_images_output_dir_name }}

location:
  latitude: {{ satelite_watcher_location_latitude }}
  longitude: {{ satelite_watcher_location_longitude }}
  altitude_m: {{ satelite_watcher_location_altitude_m }}

schedule:
  lookahead_hours: {{ satelite_watcher_lookahead_hours }}
  scheduler_interval_minutes: {{ satelite_watcher_interval_minutes }}
  pre_record_seconds: {{ satelite_watcher_pre_record_seconds }}
  post_record_seconds: {{ satelite_watcher_post_record_seconds }}
  timeout_padding_seconds: {{ satelite_watcher_timeout_padding_seconds }}
  recording_paused: {{ 'true' if satelite_watcher_recording_paused | bool else 'false' }}
  recording_pause_reason: {{ satelite_watcher_recording_pause_reason | to_json }}

filter:
  mode: {{ satelite_watcher_filter_mode }}
  min_elevation_deg: {{ satelite_watcher_min_elevation_deg }}
  allowed_peak_azimuths:
{% for azimuth in satelite_watcher_allowed_peak_azimuths %}
    - {{ azimuth }}
{% else %}
    []
{% endfor %}

retention:
  keep_days: {{ satelite_watcher_retention_days }}

tle:
  weather_url: {{ satelite_watcher_weather_tle_url }}
  stations_url: {{ satelite_watcher_stations_tle_url }}
  user_agent: {{ satelite_watcher_tle_user_agent }}
  space_track:
    enabled: {{ 'true' if satelite_watcher_space_track_enabled | bool else 'false' }}
    login_url: {{ satelite_watcher_space_track_login_url }}
    query_base_url: {{ satelite_watcher_space_track_query_base_url }}

iss_sstv:
  enabled: {{ 'true' if satelite_watcher_iss_sstv_enabled | bool else 'false' }}
  tle_name: {{ satelite_watcher_iss_sstv_tle_name }}
  norad_id: {{ satelite_watcher_iss_sstv_norad_id }}
  events_url: {{ satelite_watcher_iss_sstv_events_url }}
  gallery_url: {{ satelite_watcher_iss_sstv_gallery_url }}
  default_frequency_hz: {{ satelite_watcher_iss_sstv_default_frequency_hz }}
  default_mode: {{ satelite_watcher_iss_sstv_default_mode }}

notifications:
  webhook_enabled: {{ 'true' if satelite_watcher_discord_webhook_url | string | length > 0 else 'false' }}
  weather_prepass:
    enabled: {{ 'true' if satelite_watcher_notify_weather_prepass_enabled | bool else 'false' }}
    timing: {{ satelite_watcher_notify_weather_prepass_timing }}
    night_before_hour: {{ satelite_watcher_notify_weather_prepass_night_before_hour }}
    night_before_minute: {{ satelite_watcher_notify_weather_prepass_night_before_minute }}
    lead_minutes: {{ satelite_watcher_notify_weather_prepass_lead_minutes }}
    digest_days: {{ satelite_watcher_notify_weather_prepass_digest_days }}
    max_passes_per_day: {{ satelite_watcher_notify_weather_prepass_max_passes_per_day }}
    priority_satellites:
{% for satellite_name in satelite_watcher_notify_weather_prepass_priority_satellites %}
      - {{ satellite_name }}
{% else %}
      []
{% endfor %}
    min_elevation_deg: {{ satelite_watcher_notify_weather_prepass_min_elevation_deg }}
    decode_profiles:
{% for profile in satelite_watcher_notify_weather_prepass_decode_profiles %}
      - {{ profile }}
{% else %}
      []
{% endfor %}
    peak_azimuths:
{% for azimuth in satelite_watcher_notify_weather_prepass_peak_azimuths %}
      - {{ azimuth }}
{% else %}
      []
{% endfor %}
  weather_image:
    enabled: {{ 'true' if satelite_watcher_notify_weather_image_enabled | bool else 'false' }}
    min_elevation_deg: {{ satelite_watcher_notify_weather_image_min_elevation_deg }}
    decode_profiles:
{% for profile in satelite_watcher_notify_weather_image_decode_profiles %}
      - {{ profile }}
{% else %}
      []
{% endfor %}
    peak_azimuths:
{% for azimuth in satelite_watcher_notify_weather_image_peak_azimuths %}
      - {{ azimuth }}
{% else %}
      []
{% endfor %}
  meteor_prepass:
    enabled: {{ 'true' if satelite_watcher_notify_meteor_prepass_enabled | bool else 'false' }}
    lead_minutes: {{ satelite_watcher_notify_meteor_prepass_lead_minutes }}
    min_elevation_deg: {{ satelite_watcher_notify_meteor_prepass_min_elevation_deg }}
    peak_azimuths:
{% for azimuth in satelite_watcher_notify_meteor_prepass_peak_azimuths %}
      - {{ azimuth }}
{% else %}
      []
{% endfor %}
  meteor_good_pass:
    enabled: {{ 'true' if satelite_watcher_notify_meteor_good_pass_enabled | bool else 'false' }}
    min_elevation_deg: {{ satelite_watcher_notify_meteor_good_pass_min_elevation_deg }}
    peak_azimuths:
{% for azimuth in satelite_watcher_notify_meteor_good_pass_peak_azimuths %}
      - {{ azimuth }}
{% else %}
      []
{% endfor %}
  iss_sstv:
    notify_on_announcement: {{ 'true' if satelite_watcher_notify_iss_sstv_on_announcement | bool else 'false' }}
    notify_on_start: {{ 'true' if satelite_watcher_notify_iss_sstv_on_start | bool else 'false' }}
