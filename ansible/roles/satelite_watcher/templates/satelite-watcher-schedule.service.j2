[Unit]
Description=Compute and schedule upcoming Satelite Watcher passes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ satelite_watcher_scheduler_user }}
Group={{ satelite_watcher_scheduler_group }}
WorkingDirectory={{ satelite_watcher_root }}
Environment=HOME={{ satelite_watcher_root }}
Environment=XDG_CONFIG_HOME={{ satelite_watcher_xdg_config_home }}
EnvironmentFile=-{{ satelite_watcher_notify_env_file }}
ExecStart={{ satelite_watcher_python_bin }} {{ satelite_watcher_bin_dir }}/build_pass_schedule.py
StandardOutput=append:{{ satelite_watcher_logs_dir }}/scheduler.log
StandardError=append:{{ satelite_watcher_logs_dir }}/scheduler.log
