[Unit]
Description=BatchYT liked videos ingest
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User={{ batchyt_run_user }}
Group={{ batchyt_run_group }}
EnvironmentFile=/etc/batchyt-liked.env
WorkingDirectory={{ batchyt_app_dir }}
ExecStart={{ batchyt_root_dir }}/batchyt-liked-run.sh
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
