[Unit]
Description=Tresor Grafana Discord alert relay
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ grafana_alerting_relay_env_file }}
ExecStart=/usr/bin/python3 {{ grafana_alerting_relay_dir }}/discord_alert_relay.py
Restart=always
RestartSec=5
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ grafana_alerting_relay_dir }}

[Install]
WantedBy=multi-user.target
