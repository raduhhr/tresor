#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

import requests
import yaml


CONFIG_PATH = Path("{{ satelite_watcher_config_dir }}/config.yml")
SATELLITES_PATH = Path("{{ satelite_watcher_config_dir }}/satellites.yml")


def load_yaml(path: Path) -> dict:
    with path.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle) or {}


def load_existing_cache(path: Path) -> dict:
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def parse_tle_triplets(raw_text: str) -> list[dict]:
    lines = [line.strip() for line in raw_text.splitlines() if line.strip()]
    triplets = []
    index = 0
    while index < len(lines):
        if (
            index + 1 < len(lines)
            and lines[index].startswith("1 ")
            and lines[index + 1].startswith("2 ")
        ):
            line1, line2 = lines[index:index + 2]
            triplets.append({"name": line1[2:7].strip(), "line1": line1, "line2": line2})
            index += 2
            continue
        if index + 2 < len(lines):
            name, line1, line2 = lines[index:index + 3]
            if line1.startswith("1 ") and line2.startswith("2 "):
                triplets.append({"name": name, "line1": line1, "line2": line2})
                index += 3
                continue
        index += 1
    return triplets


def triplet_matches(triplet: dict, satellite: dict) -> bool:
    wanted_name = (satellite.get("tle_name") or satellite.get("name") or "").strip().upper()
    if wanted_name and triplet["name"].strip().upper() == wanted_name:
        return True

    wanted_norad = str(satellite.get("norad_id", "")).strip()
    if wanted_norad:
        return triplet["line1"][2:7].strip() == wanted_norad

    return False


def fetch_tle_triplets(url: str, headers: dict, fetch_errors: list[str]) -> tuple[list[dict], str | None]:
    try:
        response = requests.get(url, headers=headers, timeout=20)
        response.raise_for_status()
        return parse_tle_triplets(response.text), response.headers.get("date")
    except requests.RequestException as exc:
        fetch_errors.append(f"{url}: {exc}")
        return [], None


def login_space_track(config: dict, headers: dict, fetch_errors: list[str]) -> requests.Session | None:
    space_track_cfg = config.get("tle", {}).get("space_track", {})
    if not space_track_cfg.get("enabled"):
        return None

    identity = os.environ.get("SATELITE_WATCHER_SPACE_TRACK_USERNAME", "").strip()
    password = os.environ.get("SATELITE_WATCHER_SPACE_TRACK_PASSWORD", "")
    if not identity or not password:
        fetch_errors.append("Space-Track is enabled but credentials are missing from environment")
        return None

    session = requests.Session()
    session.headers.update(headers)
    try:
        response = session.post(
            space_track_cfg.get("login_url", "https://www.space-track.org/ajaxauth/login"),
            data={"identity": identity, "password": password},
            timeout=20,
        )
        response.raise_for_status()
    except requests.RequestException as exc:
        fetch_errors.append(f"Space-Track login failed: {exc}")
        return None

    return session


def fetch_space_track_tle_triplets(
    session: requests.Session,
    config: dict,
    norad_ids: str,
    fetch_errors: list[str],
) -> tuple[list[dict], str | None]:
    query_base = config.get("tle", {}).get(
        "space_track", {}
    ).get("query_base_url", "https://www.space-track.org/basicspacedata/query")
    url = (
        f"{query_base}/class/gp/NORAD_CAT_ID/{norad_ids}"
        "/orderby/NORAD_CAT_ID%20asc/format/tle"
    )
    try:
        response = session.get(url, timeout=20)
        response.raise_for_status()
        return parse_tle_triplets(response.text), response.headers.get("date")
    except requests.RequestException as exc:
        fetch_errors.append(f"Space-Track NORAD {norad_ids}: {exc}")
        return [], None


def main() -> int:
    config = load_yaml(CONFIG_PATH)
    satellites_payload = load_yaml(SATELLITES_PATH)
    satellites = satellites_payload.get("satellites", [])
    if config.get("iss_sstv", {}).get("enabled"):
        satellites.append(
            {
                "name": config["iss_sstv"]["tle_name"],
                "tle_name": config["iss_sstv"]["tle_name"],
                "norad_id": config["iss_sstv"]["norad_id"],
            }
        )
    cache_path = Path(config["paths"]["tle_cache_file"])
    cache_path.parent.mkdir(parents=True, exist_ok=True)

    existing_cache = load_existing_cache(cache_path)
    existing_by_name = {
        item["name"]: item
        for item in existing_cache.get("satellites", [])
        if item.get("name")
    }

    headers = {"User-Agent": config["tle"]["user_agent"]}
    fetched_triplets = []
    fetched_at = None
    fetch_errors = []
    space_track_session = None
    space_track_attempted = False
    space_track_candidates = []
    unresolved_satellites = []

    for tle_url in [config["tle"]["weather_url"], config["tle"]["stations_url"]]:
        triplets, date_header = fetch_tle_triplets(tle_url, headers, fetch_errors)
        fetched_triplets.extend(triplets)
        fetched_at = date_header or fetched_at

    resolved_satellites = []
    missing = []
    for satellite in satellites:
        matched = next((triplet for triplet in fetched_triplets if triplet_matches(triplet, satellite)), None)
        if not matched and satellite.get("norad_id"):
            catalog_url = f"https://celestrak.org/NORAD/elements/gp.php?CATNR={satellite['norad_id']}&FORMAT=TLE"
            triplets, date_header = fetch_tle_triplets(catalog_url, headers, fetch_errors)
            fetched_triplets.extend(triplets)
            fetched_at = date_header or fetched_at
            matched = next((triplet for triplet in triplets if triplet_matches(triplet, satellite)), None)
        if matched:
            resolved_satellites.append(
                {
                    "name": satellite["name"],
                    "tle_name": matched["name"],
                    "line1": matched["line1"],
                    "line2": matched["line2"],
                }
            )
            if "frequency_hz" in satellite:
                resolved_satellites[-1]["frequency_hz"] = satellite["frequency_hz"]
            continue

        cached = existing_by_name.get(satellite["name"])
        if cached:
            if "frequency_hz" in satellite:
                cached["frequency_hz"] = satellite["frequency_hz"]
            resolved_satellites.append(cached)
            continue

        if satellite.get("norad_id") and config.get("tle", {}).get("space_track", {}).get("enabled"):
            space_track_candidates.append(satellite)
            continue

        unresolved_satellites.append(satellite)

    if space_track_candidates:
        if not space_track_attempted:
            space_track_session = login_space_track(config, headers, fetch_errors)
            space_track_attempted = True
        if space_track_session:
            norad_ids = ",".join(str(satellite["norad_id"]) for satellite in space_track_candidates)
            triplets, date_header = fetch_space_track_tle_triplets(
                space_track_session,
                config,
                norad_ids,
                fetch_errors,
            )
            fetched_triplets.extend(triplets)
            fetched_at = date_header or fetched_at
            for satellite in space_track_candidates:
                matched = next((triplet for triplet in triplets if triplet_matches(triplet, satellite)), None)
                if matched:
                    resolved_satellites.append(
                        {
                            "name": satellite["name"],
                            "tle_name": matched["name"],
                            "line1": matched["line1"],
                            "line2": matched["line2"],
                        }
                    )
                    if "frequency_hz" in satellite:
                        resolved_satellites[-1]["frequency_hz"] = satellite["frequency_hz"]
                    continue
                unresolved_satellites.append(satellite)
        else:
            unresolved_satellites.extend(space_track_candidates)

    missing = [satellite["name"] for satellite in unresolved_satellites]

    if not resolved_satellites:
        if fetch_errors:
            print(
                "TLE refresh errors: " + "; ".join(fetch_errors),
                file=sys.stderr,
            )
        print("no TLE entries resolved for configured scheduled targets", file=sys.stderr)
        return 1

    payload = {
        "updated_at": fetched_at,
        "source_url": [config["tle"]["weather_url"], config["tle"]["stations_url"]],
        "missing": missing,
        "satellites": resolved_satellites,
    }
    with cache_path.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")

    if fetch_errors:
        print(
            "warning: partial TLE refresh failure: " + "; ".join(fetch_errors),
            file=sys.stderr,
        )

    if missing:
        print(f"warning: missing TLEs for {', '.join(missing)}", file=sys.stderr)

    print(f"cached {len(resolved_satellites)} scheduled target TLE entries at {cache_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
