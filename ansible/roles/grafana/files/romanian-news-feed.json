          "rawQuery": true,
          "rawSql": "SELECT s.name AS source, i.title, left(regexp_replace(coalesce(i.description, ''), '<[^>]+>', '', 'g'), 700) AS summary, i.first_seen_at, i.canonical_url AS url FROM items i JOIN sources s ON s.id = i.source_id WHERE i.item_type = 'article' AND s.enabled AND s.category = 'romanian_news' AND i.first_seen_at >= date_trunc('day', now()) ORDER BY i.first_seen_at DESC LIMIT 100;",
