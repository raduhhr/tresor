          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.politician_name, max(p.party) AS party, count(*) AS votes_recorded, count(*) FILTER (WHERE p.vote_choice = 'yes') AS yes, count(*) FILTER (WHERE p.vote_choice = 'no') AS no, count(*) FILTER (WHERE p.vote_choice = 'abstain') AS abstain, count(*) FILTER (WHERE p.vote_choice = 'not_voted') AS not_voted, round(100.0 * count(*) FILTER (WHERE p.vote_choice <> 'not_voted') / NULLIF(count(*), 0), 1) AS participation_pct FROM parliament_vote_positions p JOIN parliament_votes v ON v.vote_id = p.vote_id WHERE $__timeFilter(v.vote_time) GROUP BY p.politician_key, p.politician_name ORDER BY participation_pct ASC, votes_recorded DESC, p.politician_name LIMIT 120;",
          "refId": "A"
        }
      ],
      "title": "Politician Participation",
      "type": "table"
